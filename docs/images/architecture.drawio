<mxfile host="app.diagrams.net">
  <diagram id="arch" name="Self Improving Agentic Security">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="760" pageHeight="520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Self Improving&lt;br&gt;Agentic Security" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="5" width="280" height="65" as="geometry" />
        </mxCell>
        <mxCell id="desc" value="Frontier agents orchestrate a red team of open weight models to generate datasets of prompt injection attacks, then use them to improve a detection and classification pipeline. It runs as an iterative loop: each iteration, shown below, scores the pipeline on held-out data and keeps only the changes that improve it." style="text;html=1;fontSize=12;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="75" width="470" height="80" as="geometry" />
        </mxCell>

        <mxCell id="frontier" value="Opus 5.5&lt;br&gt;GPT-6" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="155" y="160" width="115" height="60" as="geometry" />
        </mxCell>
        <mxCell id="orch" value="Orchestrator agents" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="320" y="160" width="150" height="60" as="geometry" />
        </mxCell>

        <mxCell id="apis" value="Kimi&lt;br&gt;Deepseek&lt;br&gt;GLM 5.3" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="25" y="220" width="115" height="70" as="geometry" />
        </mxCell>
        <mxCell id="local" value="Local models:&lt;br&gt;GLM 5.3 flash Q1&lt;br&gt;GLM 5.3 flash Q2 Abliterated&lt;br&gt;Qwen3.8, Qwen4" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="5" y="310" width="190" height="85" as="geometry" />
        </mxCell>
        <mxCell id="red" value="Red team agents" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="220" y="260" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="data" value="Prompt injection and jailbreak datasets" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="1">
          <mxGeometry x="220" y="380" width="85" height="95" as="geometry" />
        </mxCell>

        <mxCell id="sec" value="Security controls" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="decide" value="Jev&lt;br&gt;Decision APIs&lt;br&gt;&lt;i&gt;(optional)&lt;/i&gt;" style="ellipse;shape=cloud;whiteSpace=wrap;html=1;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="610" y="210" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="sys1" value="System one models:&lt;br&gt;Clef, Laya, Mica, d1" style="ellipse;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="595" y="315" width="150" height="80" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="NLP&lt;br&gt;Normalization&lt;br&gt;RegEx&lt;br&gt;&lt;i&gt;Weight-space programming&lt;br&gt;(later phase)&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="370" width="150" height="95" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="frontier" target="orch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=1;exitDx=0;exitDy=0;entryX=0.67;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="red">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.8;exitY=1;exitDx=0;exitDy=0;entryX=0.13;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="orch" target="sec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.8;exitY=0.5;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="apis" target="red">
          <mxGeometry relative="1" as="geometry" />
